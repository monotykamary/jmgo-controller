{
  "name": "jmgo-controller",
  "version": "0.8.0",
  "description": "Local-network control, ADB automation, verified Play delivery, and certified Artemis streaming for JMGO projectors",
  "type": "module",
  "bin": {
    "jmgo": "./dist/cli.js",
    "jmgo-artemis": "./skills/jmgo-artemis/scripts/jmgo-artemis",
    "jmgo-control": "./skills/jmgo-control/scripts/jmgo-control",
    "jmgo-stream-test": "./skills/jmgo-stream-test/scripts/jmgo-stream-test"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs dist",
    "build": "pnpm clean && tsc",
    "check": "pnpm check:sensitive && tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "check:sensitive": "node scripts/check-sensitive.mjs",
    "test": "node scripts/clean.mjs .test-dist && tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js experiments/artemis-jmgo/*.test.mjs experiments/decoder-pacing/*.test.mjs",
    "simulate:pacing": "node experiments/decoder-pacing/simulate.mjs",
    "simulate:avsync": "node experiments/artemis-jmgo/simulate-audio-route.mjs",
    "prepack": "pnpm build"
  },
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.5",
  "keywords": [
    "pi-package",
    "jmgo",
    "projector",
    "android-tv",
    "adb",
    "remote-control",
    "home-automation",
    "moonlight",
    "sunshine",
    "agent-skills"
  ],
  "license": "MIT",
  "author": "JMGO Controller contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotykamary/jmgo-controller.git"
  },
  "bugs": {
    "url": "https://github.com/monotykamary/jmgo-controller/issues"
  },
  "homepage": "https://github.com/monotykamary/jmgo-controller#readme",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
