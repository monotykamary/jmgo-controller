+    private void beginJmgoVideoStarvation(long nowNs) {
+        if (preparedStarvationStartNs != 0) {
+            return;
+        }
+
+        preparedStarvationStartNs = nowNs;
+        consecutivePreparedEmptyFrames = 0;
+        starvationIdrRequested = false;
+        starvationCodecRecoveryAttempted = false;
+        starvationReconnectRequested = false;
+        LimeLog.warning("JMGO video starvation started: stage=" +
+                describeJmgoStarvationStage(nowNs) +
+                ", decoded=" + decodedImageQueue.size() +
+                ", prepared=" + preparedImageQueue.size() +
+                ", nativePending=" + MoonBridge.getPendingVideoFrames());
+    }
+
+    private void handleJmgoVideoStarvation(long nowNs) {
+        if (preparedStarvationStartNs == 0) {
+            return;
+        }
+
+        long stalledNs = nowNs - preparedStarvationStartNs;
+        if (!starvationIdrRequested && stalledNs >= VIDEO_STARVATION_IDR_NS) {
+            starvationIdrRequested = true;
+            MoonBridge.requestIdrFrame();
+            LimeLog.warning("JMGO video starvation requested IDR after " +
+                    (stalledNs / 1_000_000L) + " ms: stage=" +
+                    describeJmgoStarvationStage(nowNs));
+        }
+
+        if (!starvationReconnectRequested &&
+                !starvationCodecRecoveryAttempted &&
+                stalledNs >= VIDEO_STARVATION_CODEC_RECOVERY_NS &&
+                stageAgeNs(nowNs, lastDecodeUnitNs) <= VIDEO_STAGE_FRESH_NS &&
+                starvationCodecRecoveryRequested.compareAndSet(false, true)) {
+            starvationCodecRecoveryAttempted = true;
+            LimeLog.warning("JMGO video starvation scheduled codec restart after " +
+                    (stalledNs / 1_000_000L) + " ms: outputAge=" +
+                    printableStageAgeMs(nowNs, lastDecoderOutputNs) +
+                    " ms, readerAge=" + printableStageAgeMs(nowNs, lastImageReaderNs) +
+                    " ms, preparedAge=" + printableStageAgeMs(nowNs, lastPreparedImageNs) +
+                    " ms");
+        }
+
+        if (!starvationReconnectRequested && stalledNs >= VIDEO_STARVATION_RECONNECT_NS) {
+            starvationReconnectRequested = true;
+            String stage = describeJmgoStarvationStage(nowNs);
+            LimeLog.warning("JMGO video starvation requesting stream restart after " +
+                    (stalledNs / 1_000_000L) + " ms: stage=" + stage);
+            videoStallListener.requestStreamRestart(stage, stalledNs / 1_000_000L);
+        }
+    }
