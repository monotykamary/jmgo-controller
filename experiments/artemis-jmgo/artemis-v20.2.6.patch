+JNIEXPORT void JNICALL
+Java_com_limelight_nvstream_jni_MoonBridge_copyYuvPlane(JNIEnv* env, jclass clazz,
+                                                         jobject sourceBuffer,
+                                                         jint sourceRowStride,
+                                                         jint sourcePixelStride,
+                                                         jobject destinationBuffer,
+                                                         jint destinationRowStride,
+                                                         jint destinationPixelStride,
+                                                         jint width,
+                                                         jint height) {
+    unsigned char* source = (*env)->GetDirectBufferAddress(env, sourceBuffer);
+    unsigned char* destination = (*env)->GetDirectBufferAddress(env, destinationBuffer);
+    if (source == NULL || destination == NULL || width <= 0 || height <= 0) {
+        return;
+    }
+
+    if (sourcePixelStride == destinationPixelStride) {
+        size_t rowBytes = (size_t)(width - 1) * sourcePixelStride + 1;
+        for (int row = 0; row < height; row++) {
+            memcpy(destination + (size_t)row * destinationRowStride,
+                   source + (size_t)row * sourceRowStride,
+                   rowBytes);
+        }
+    }
+    else {
+        for (int row = 0; row < height; row++) {
+            unsigned char* sourceRow = source + (size_t)row * sourceRowStride;
+            unsigned char* destinationRow = destination + (size_t)row * destinationRowStride;
+            for (int column = 0; column < width; column++) {
+                destinationRow[(size_t)column * destinationPixelStride] =
+                    sourceRow[(size_t)column * sourcePixelStride];
+            }
+        }
+    }
