+    private void requestJmgoStreamRestart(String stalledStage, long stalledDurationMs) {
+        runOnUiThread(() -> {
+            if (jmgoStallRestartRequested || isFinishing() || isDestroyed()) {
+                return;
+            }
+
+            long nowMs = SystemClock.uptimeMillis();
+            synchronized (Game.class) {
+                if (nowMs - lastJmgoStallRestartMs > JMGO_STALL_RESTART_WINDOW_MS) {
+                    consecutiveJmgoStallRestarts = 0;
+                }
+                if (consecutiveJmgoStallRestarts >= JMGO_STALL_MAX_RESTARTS) {
+                    LimeLog.severe("JMGO video starvation reconnect limit reached: stage=" +
+                            stalledStage + ", duration=" + stalledDurationMs + " ms");
+                    return;
+                }
+                consecutiveJmgoStallRestarts++;
+                lastJmgoStallRestartMs = nowMs;
+            }
+
+            jmgoStallRestartRequested = true;
+            LimeLog.warning("JMGO restarting stream after video starvation: stage=" +
+                    stalledStage + ", duration=" + stalledDurationMs + " ms, attempt=" +
+                    consecutiveJmgoStallRestarts);
