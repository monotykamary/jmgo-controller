+                (audioPacketsWritten & 0xF) != 0 ||
+                !track.getTimestamp(audioTimestamp)) {
+            return;
+        }
+
+        long queuedFrames = firstFramePosition - audioTimestamp.framePosition;
+        if (queuedFrames < 0) {
+            return;
         }
+
+        double effectiveSampleRate = configuredSampleRate *
+                Math.max(0.98f, lastAudioPlaybackSpeed);
+        long firstFramePresentationNs = audioTimestamp.nanoTime +
+                (long) (queuedFrames * 1_000_000_000L / effectiveSampleRate);
+        long nowNs = System.nanoTime();
+        long measuredSinkLeadNs = firstFramePresentationNs - nowNs;
+        long measuredQueueLeadNs = readyAudioFrames.size() * audioPacketDurationNs;
+        JmgoAvSyncClock.updateAudioPresentation(
+                frame.mediaPresentationTimeMs, frame.receivedAtNs,
+                firstFramePresentationNs, measuredSinkLeadNs,
+                measuredQueueLeadNs, nowNs);
