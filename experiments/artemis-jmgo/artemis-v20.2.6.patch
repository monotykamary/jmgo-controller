+    private static void updateAtomicMaximum(AtomicLong value, long sample) {
+        long previous;
+        do {
+            previous = value.get();
+            if (sample <= previous) {
+                return;
+            }
+        } while (!value.compareAndSet(previous, sample));
+    }
