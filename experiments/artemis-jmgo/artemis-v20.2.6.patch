+    private void copyDecodedImage(Image source, Image destination) {
+        // ImageWriter allocates buffers at the physical Surface size. Preserve the decoded
+        // crop so SurfaceFlinger scales the 720p image across the full display layer.
+        destination.setCropRect(source.getCropRect());
+
+        Image.Plane[] sourcePlanes = source.getPlanes();
+        Image.Plane[] destinationPlanes = destination.getPlanes();
+        if (sourcePlanes.length != destinationPlanes.length) {
+            throw new IllegalStateException("Mismatched YUV plane count");
+        }
+
+        for (int planeIndex = 0; planeIndex < sourcePlanes.length; planeIndex++) {
+            Image.Plane sourcePlane = sourcePlanes[planeIndex];
+            Image.Plane destinationPlane = destinationPlanes[planeIndex];
+            int planeWidth = planeIndex == 0 ? initialWidth : (initialWidth + 1) / 2;
+            int planeHeight = planeIndex == 0 ? initialHeight : (initialHeight + 1) / 2;
+            MoonBridge.copyYuvPlane(
+                    sourcePlane.getBuffer(), sourcePlane.getRowStride(), sourcePlane.getPixelStride(),
+                    destinationPlane.getBuffer(), destinationPlane.getRowStride(),
+                    destinationPlane.getPixelStride(), planeWidth, planeHeight);
+        }
+    }
