+    private void initializeJmgoImagePipeline() {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.Q || renderTarget == null) {
+            return;
+        }
+
+        try {
+            decodedImageReader = ImageReader.newInstance(
