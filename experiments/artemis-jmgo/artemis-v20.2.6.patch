+    private int decodeJmgoFrameMarker(Image source) {
+        if (!BuildConfig.DEBUG) {
+            return -1;
+        }
+
+        Rect crop = source.getCropRect();
+        int markerCells = FRAME_MARKER_SYNC_BITS + FRAME_MARKER_VALUE_BITS;
+        if (crop.width() < markerCells * 4 || crop.height() < 80) {
+            return -1;
+        }
+
+        Image.Plane yPlane = source.getPlanes()[0];
+        ByteBuffer luma = yPlane.getBuffer();
+        int sampleY = crop.bottom - Math.max(2, crop.height() / 80);
+        int sync = 0;
+        int value = 0;
+        for (int cell = 0; cell < markerCells; cell++) {
+            int sampleX = crop.left +
+                    (int) (((long) (cell * 2 + 1) * crop.width()) /
+                            (markerCells * 2L));
+            int index = sampleY * yPlane.getRowStride() +
+                    sampleX * yPlane.getPixelStride();
+            if (index < 0 || index >= luma.limit()) {
+                return -1;
+            }
+            int bit = (luma.get(index) & 0xFF) >= 128 ? 1 : 0;
+            if (cell < FRAME_MARKER_SYNC_BITS) {
+                sync |= bit << cell;
+            }
+            else {
+                value |= bit << (cell - FRAME_MARKER_SYNC_BITS);
+            }
+        }
+        return sync == FRAME_MARKER_SYNC ? value : -1;
+    }
