+            decodedImageReaderThread = new HandlerThread(
+                    "Video - JMGO ImageReader", Process.THREAD_PRIORITY_URGENT_DISPLAY);
+            decodedImageReaderThread.start();
+            decodedImageReader.setOnImageAvailableListener(reader -> {
+                Image image = null;
+                try {
+                    while ((image = reader.acquireNextImage()) != null) {
+                        if (decodedImageQueue.size() >= DECODED_IMAGE_QUEUE_LIMIT) {
+                            Image oldest = decodedImageQueue.poll();
+                            if (oldest != null) {
+                                oldest.close();
+                            }
+                        }
+                        decodedImageQueue.offer(image);
+                        image = null;
+                    }
+                }
+                catch (IllegalStateException e) {
+                    LimeLog.warning("JMGO image reader stalled: " + e.getMessage());
+                }
+                finally {
+                    if (image != null) {
+                        image.close();
+                    }
+                }
+            }, new Handler(decodedImageReaderThread.getLooper()));
+            jmgoImagePipeline = true;
+            LimeLog.info("JMGO decoded YUV image pipeline enabled");
+        }
+        catch (RuntimeException e) {
+            jmgoImagePipeline = false;
+            LimeLog.warning("JMGO image pipeline unavailable: " + e.getMessage());
+            clearDecodedImages();
+            if (decodedImageReader != null) {
+                decodedImageReader.close();
+                decodedImageReader = null;
+            }
+            if (decodedImageWriter != null) {
