+    public static long getAudioHoldbackNs() {
+        long holdbackNs = BASELINE_HOLDBACK_NS - schedulerCompensationNs.get();
+        return Math.max(MINIMUM_VIDEO_HOLDBACK_NS,
+                Math.min(holdbackNs, MAXIMUM_VIDEO_HOLDBACK_NS));
+    }
+
+    public static float getAudioPlaybackSpeed(long nowNs,
+                                              boolean drainAudioQueue) {
+        long phaseErrorNs =
+                audioRouteBaselineSamples.get() >= AUDIO_ROUTE_BASELINE_SAMPLES ?
+                        getVideoDepthChangeNs(nowNs) - audioRouteAdjustmentNs.get() : 0;
+        long desiredSpeed = PLAYBACK_SPEED_SCALE -
+                phaseErrorNs / PLAYBACK_SPEED_ERROR_DIVISOR;
+        desiredSpeed = Math.max(MINIMUM_PLAYBACK_SPEED,
+                Math.min(desiredSpeed, MAXIMUM_PLAYBACK_SPEED));
+        if (drainAudioQueue) {
+            desiredSpeed = MAXIMUM_PLAYBACK_SPEED;
+        }
+        long speed = slewAtomic(appliedPlaybackSpeed, desiredSpeed,
+                MAXIMUM_PLAYBACK_SPEED_STEP);
+        return (float) speed / PLAYBACK_SPEED_SCALE;
+    }
+
+    public static float getCurrentAudioPlaybackSpeed() {
+        return (float) appliedPlaybackSpeed.get() / PLAYBACK_SPEED_SCALE;
+    }
+
+    public static long getVideoHoldbackNs(long nowNs) {
+        long updatedAtNs = videoUpdatedAtNs.get();
+        if (updatedAtNs == 0 || nowNs - updatedAtNs > VIDEO_CLOCK_STALE_NS) {
+            return BASELINE_HOLDBACK_NS;
+        }
+        return videoHoldbackNs.get();
+    }
+
+    public static long getSchedulerCompensationNs() {
+        return schedulerCompensationNs.get();
+    }
+
+    public static long getAudioSinkLeadNs() {
+        return sinkLeadNs.get();
+    }
+
+    public static long getAudioQueueLeadNs() {
+        return audioQueueLeadNs.get();
+    }
+
+    public static long getAudioRouteAdjustmentNs() {
+        return audioRouteAdjustmentNs.get();
+    }
+
+    public static long getVideoDepthChangeNs(long nowNs) {
+        long updatedAtNs = videoUpdatedAtNs.get();
+        long baselineHoldbackNs = videoBaselineHoldbackNs.get();
+        if (baselineHoldbackNs < 0 ||
+                videoBaselineSamples.get() < VIDEO_BASELINE_SAMPLES ||
+                nowNs - updatedAtNs > VIDEO_CLOCK_STALE_NS) {
+            return 0;
+        }
+        return videoHoldbackNs.get() - baselineHoldbackNs;
+    }
+
+    public static long getBaselineHoldbackNs() {
+        return BASELINE_HOLDBACK_NS;
+    }
+
+    private static long slewAtomic(AtomicLong value, long target, long maximumStep) {
+        long previous;
+        long next;
+        do {
+            previous = value.get();
+            long difference = target - previous;
+            long step = Math.max(-maximumStep, Math.min(difference, maximumStep));
+            next = previous + step;
+        } while (!value.compareAndSet(previous, next));
+        return next;
+    }
+
+    private static void smoothAtomic(AtomicLong value, long sample, int filterShift) {
+        long previous;
+        long filtered;
+        do {
+            previous = value.get();
+            filtered = previous + ((sample - previous) >> filterShift);
+        } while (!value.compareAndSet(previous, filtered));
+    }
+}
