+                    DECODED_IMAGE_READER_CAPACITY);
+            decodedImageWriter = ImageWriter.newInstance(
+                    renderTarget, 8, ImageFormat.YUV_420_888);
+            decodedImageReaderThread = new HandlerThread(
+                    "Video - JMGO ImageReader", Process.THREAD_PRIORITY_URGENT_DISPLAY);
+            decodedImageReaderThread.start();
+            decodedImageReader.setOnImageAvailableListener(reader -> {
+                Image image = null;
+                try {
+                    while ((image = reader.acquireNextImage()) != null) {
+                        long imageTimestampNs = image.getTimestamp();
+                        if (lastDecodedImageTimestampNs != 0) {
+                            long timestampDeltaNs = imageTimestampNs - lastDecodedImageTimestampNs;
+                            long minimumFrameSpacingNs = 500_000_000L / Math.max(1, refreshRate);
+                            if ((timestampDeltaNs <= 0 || timestampDeltaNs < minimumFrameSpacingNs) &&
+                                    decodedImageQueue.size() >= DECODED_IMAGE_QUEUE_LIMIT) {
+                                Image superseded = decodedImageQueue.pollLast();
+                                if (superseded != null) {
+                                    superseded.close();
+                                    LimeLog.info("JMGO decoded supplemental image coalesced");
+                                }
+                            }
+                        }
+                        lastDecodedImageTimestampNs = imageTimestampNs;
+                        if (decodedImageQueue.size() >= DECODED_IMAGE_QUEUE_LIMIT) {
+                            Image oldest = decodedImageQueue.poll();
+                            if (oldest != null) {
+                                oldest.close();
+                                LimeLog.warning("JMGO decoded image queue dropped oldest frame");
+                            }
+                        }
+                        decodedImageQueue.offer(image);
+                        image = null;
+                    }
+                }
+                catch (IllegalStateException e) {
+                    LimeLog.warning("JMGO image reader stalled: " + e.getMessage());
+                }
+                finally {
+                    if (image != null) {
+                        image.close();
+                    }
+                }
+            }, new Handler(decodedImageReaderThread.getLooper()));
+            jmgoImagePipeline = true;
+            LimeLog.info("JMGO decoded YUV image pipeline enabled");
