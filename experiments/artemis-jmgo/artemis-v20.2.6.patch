+            }
+            return new JmgoPreparedImage(writerImage, sourceTimestampNs,
+                    decodedImage.mediaPresentationTimeMs);
+        }
+        catch (RuntimeException e) {
+            if (writerImage != null) {
+                writerImage.close();
+            }
+            LimeLog.warning("JMGO image writer rejected frame: " + e.getMessage());
+            return null;
