+                        doCodecRecoveryIfRequired(CR_FLAG_CHOREOGRAPHER);
+                        LockSupport.parkNanos(1_000_000L);
+                        if (Thread.interrupted()) {
+                            return;
+                        }
+                        continue;
+                    }
+                    outputPacingStarted = true;
+                    nextReleaseNs = System.nanoTime();
+                    LimeLog.info("JMGO timer pacing started with " + reserveSize +
+                            " decoded frame available");
+                }
+
+                long nowNs = System.nanoTime();
+                if (nowNs < nextReleaseNs) {
+                    LockSupport.parkNanos(nextReleaseNs - nowNs);
+                    if (Thread.interrupted()) {
+                        return;
+                    }
+                    nowNs = System.nanoTime();
+                }
+
+                long schedulerDelayNs = nowNs - nextReleaseNs;
+                if (schedulerDelayNs >= 25_000_000L) {
+                    LimeLog.warning("JMGO timer scheduler delay: " +
