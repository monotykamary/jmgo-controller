+        LimeLog.info("JMGO video starvation recovered after " +
+                ((nowNs - preparedStarvationStartNs) / 1_000_000L) +
+                " ms with " + preparedImageQueue.size() + " prepared frames");
+        preparedStarvationStartNs = 0;
+        consecutivePreparedEmptyFrames = 0;
+        starvationIdrRequested = false;
+        starvationCodecRecoveryAttempted = false;
+        starvationReconnectRequested = false;
+        starvationCodecRecoveryRequested.set(false);
+    }
