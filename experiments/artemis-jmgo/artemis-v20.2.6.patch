+        float speed = JmgoAvSyncClock.getAudioPlaybackSpeed(
+                readyAudioFrames.size() >= JMGO_AUDIO_QUEUE_DRAIN_FRAMES);
+        if (Math.abs(speed - lastAudioPlaybackSpeed) < 0.0001f) {
+            return;
