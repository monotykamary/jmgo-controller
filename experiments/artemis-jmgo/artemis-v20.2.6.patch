+++ b/app/src/main/java/com/limelight/binding/av/JmgoAvSyncClock.java
@@ -0,0 +1,343 @@
+package com.limelight.binding.av;
+
+import java.util.concurrent.atomic.AtomicLong;
+
+public final class JmgoAvSyncClock {
+    private static final long NANOS_PER_MILLISECOND = 1_000_000L;
+    private static final long NANOS_PER_SECOND = 1_000_000_000L;
+    private static final long VIDEO_INPUT_LEAD_NS = 125 * NANOS_PER_MILLISECOND;
+    private static final int FALLBACK_DECODED_IMAGES = 10;
+    private static final int FALLBACK_PREPARED_IMAGES = 5;
+    private static final int STREAM_FRAMES_PER_SECOND = 60;
+    private static final long PRESENTATION_HANDOFF_LEAD_NS = 15 * NANOS_PER_MILLISECOND;
+    private static final long NOMINAL_VIDEO_HOLDBACK_NS =
+            VIDEO_INPUT_LEAD_NS +
+            (FALLBACK_DECODED_IMAGES + FALLBACK_PREPARED_IMAGES) *
+                    NANOS_PER_SECOND / STREAM_FRAMES_PER_SECOND +
+            PRESENTATION_HANDOFF_LEAD_NS;
+    private static final long MINIMUM_VIDEO_HOLDBACK_NS =
+            VIDEO_INPUT_LEAD_NS +
+            5 * NANOS_PER_SECOND / STREAM_FRAMES_PER_SECOND +
+            PRESENTATION_HANDOFF_LEAD_NS;
+    private static final long MAXIMUM_VIDEO_HOLDBACK_NS =
+            VIDEO_INPUT_LEAD_NS +
+            30 * NANOS_PER_SECOND / STREAM_FRAMES_PER_SECOND +
+            PRESENTATION_HANDOFF_LEAD_NS;
+    private static final long FALLBACK_AUDIO_SINK_LEAD_NS = 300 * NANOS_PER_MILLISECOND;
+    private static final long MAXIMUM_AUDIO_SINK_LEAD_NS = 500 * NANOS_PER_MILLISECOND;
+    private static final long MAXIMUM_AUDIO_QUEUE_LEAD_NS = 2 * NANOS_PER_SECOND;
+    private static final long MAXIMUM_AUDIO_WRITE_HOLDBACK_NS = 650 * NANOS_PER_MILLISECOND;
+    private static final long MAXIMUM_AUDIO_DEADLINE_CORRECTION_NS =
+            250 * NANOS_PER_MILLISECOND;
+    private static final long MAXIMUM_AUDIO_PHASE_ERROR_NS = NANOS_PER_SECOND;
+    private static final long MAXIMUM_SCHEDULER_COMPENSATION_NS =
+            20 * NANOS_PER_MILLISECOND;
+    private static final long PLAYBACK_SPEED_SCALE = 1_000_000L;
+    private static final long MINIMUM_PLAYBACK_SPEED = 980_000L;
+    private static final long MAXIMUM_PLAYBACK_SPEED = 1_020_000L;
+    private static final long MAXIMUM_PLAYBACK_SPEED_STEP = 500L;
+    private static final long PLAYBACK_SPEED_ERROR_DIVISOR = 5_000L;
+    private static final long MEDIA_CLOCK_STALE_NS = NANOS_PER_SECOND;
+    private static final long MEDIA_TIMELINE_COMPATIBILITY_MS = 5_000;
+    private static final long VIDEO_REBASE_THRESHOLD_NS = 100 * NANOS_PER_MILLISECOND;
+    private static final long VIDEO_BASELINE_SAMPLES = 60;
+    private static final long AUDIO_PHASE_WARMUP_SAMPLES = 8;
+    private static final int VIDEO_FILTER_SHIFT = 3;
+    private static final int MEDIA_OFFSET_FILTER_SHIFT = 3;
+    private static final int AUDIO_PHASE_FILTER_SHIFT = 3;
+    private static final int AUDIO_CORRECTION_SHIFT = 4;
+    private static final int SCHEDULER_FILTER_SHIFT = 4;
+    private static final int SINK_FILTER_SHIFT = 4;
+
+    private static final AtomicLong videoHoldbackNs =
+            new AtomicLong(NOMINAL_VIDEO_HOLDBACK_NS);
+    private static final AtomicLong videoBaselineHoldbackNs = new AtomicLong(-1);
+    private static final AtomicLong videoBaselineSamples = new AtomicLong();
+    private static final AtomicLong videoUpdatedAtNs = new AtomicLong();
+    private static final AtomicLong videoMediaOffsetNs = new AtomicLong(Long.MIN_VALUE);
+    private static final AtomicLong videoMediaTimeMs = new AtomicLong(-1);
+    private static final AtomicLong videoMediaUpdatedAtNs = new AtomicLong();
+    private static final AtomicLong schedulerCompensationNs = new AtomicLong();
+    private static final AtomicLong appliedPlaybackSpeed =
+            new AtomicLong(PLAYBACK_SPEED_SCALE);
+    private static final AtomicLong audioSinkLeadNs =
+            new AtomicLong(FALLBACK_AUDIO_SINK_LEAD_NS);
+    private static final AtomicLong audioQueueLeadNs = new AtomicLong();
+    private static final AtomicLong audioPhaseErrorNs = new AtomicLong();
+    private static final AtomicLong audioPhaseSamples = new AtomicLong();
+    private static final AtomicLong audioDeadlineCorrectionNs = new AtomicLong();
+
+    private JmgoAvSyncClock() {}
+
+    public static void resetVideoClock() {
+        videoHoldbackNs.set(NOMINAL_VIDEO_HOLDBACK_NS);
+        videoBaselineHoldbackNs.set(-1);
+        videoBaselineSamples.set(0);
+        videoUpdatedAtNs.set(0);
+        videoMediaOffsetNs.set(Long.MIN_VALUE);
+        videoMediaTimeMs.set(-1);
+        videoMediaUpdatedAtNs.set(0);
+    }
+
+    public static void resetAudioFeedback() {
+        schedulerCompensationNs.set(0);
+        appliedPlaybackSpeed.set(PLAYBACK_SPEED_SCALE);
+        audioSinkLeadNs.set(FALLBACK_AUDIO_SINK_LEAD_NS);
+        audioQueueLeadNs.set(0);
+        audioPhaseErrorNs.set(0);
+        audioPhaseSamples.set(0);
+    }
+
+    public static void updateVideoPresentation(long sourceTimestampNs,
+                                               long mediaPresentationTimeMs,
+                                               long presentationTargetNs,
+                                               long updateTimeNs) {
+        if (sourceTimestampNs <= 0 || presentationTargetNs <= sourceTimestampNs) {
+            return;
+        }
+
+        long measuredHoldbackNs = VIDEO_INPUT_LEAD_NS +
+                presentationTargetNs - sourceTimestampNs;
+        if (measuredHoldbackNs < MINIMUM_VIDEO_HOLDBACK_NS ||
+                measuredHoldbackNs > MAXIMUM_VIDEO_HOLDBACK_NS) {
+            return;
+        }
+
+        long previousUpdatedAtNs = videoUpdatedAtNs.get();
+        long previousHoldbackNs = videoHoldbackNs.get();
+        long differenceNs = measuredHoldbackNs - previousHoldbackNs;
+        long baselineSamples = videoBaselineSamples.get();
+        long filteredHoldbackNs;
+        long baselineHoldbackNs = videoBaselineHoldbackNs.get();
+        if (previousUpdatedAtNs == 0 ||
+                updateTimeNs - previousUpdatedAtNs > MEDIA_CLOCK_STALE_NS) {
+            filteredHoldbackNs = measuredHoldbackNs;
+            baselineHoldbackNs = measuredHoldbackNs;
+            baselineSamples = 1;
+        }
+        else if (Math.abs(differenceNs) >= VIDEO_REBASE_THRESHOLD_NS) {
+            filteredHoldbackNs = measuredHoldbackNs;
+            baselineHoldbackNs = baselineSamples < VIDEO_BASELINE_SAMPLES ?
+                    measuredHoldbackNs :
+                    measuredHoldbackNs + baselineHoldbackNs - previousHoldbackNs;
+        }
+        else {
+            filteredHoldbackNs = previousHoldbackNs +
+                    (differenceNs >> VIDEO_FILTER_SHIFT);
+            if (baselineSamples < VIDEO_BASELINE_SAMPLES) {
+                baselineHoldbackNs = filteredHoldbackNs;
+                baselineSamples++;
+            }
+        }
+
+        videoHoldbackNs.set(filteredHoldbackNs);
+        videoBaselineHoldbackNs.set(baselineHoldbackNs);
+        videoBaselineSamples.set(baselineSamples);
+        videoUpdatedAtNs.set(updateTimeNs);
+
+        if (mediaPresentationTimeMs < 0) {
+            return;
+        }
+        long measuredMediaOffsetNs = presentationTargetNs -
+                mediaPresentationTimeMs * NANOS_PER_MILLISECOND;
+        long previousMediaOffsetNs = videoMediaOffsetNs.get();
+        long previousMediaUpdateNs = videoMediaUpdatedAtNs.get();
+        long filteredMediaOffsetNs;
+        if (previousMediaOffsetNs == Long.MIN_VALUE ||
+                updateTimeNs - previousMediaUpdateNs > MEDIA_CLOCK_STALE_NS ||
+                Math.abs(measuredMediaOffsetNs - previousMediaOffsetNs) >=
+                        VIDEO_REBASE_THRESHOLD_NS) {
+            filteredMediaOffsetNs = measuredMediaOffsetNs;
+        }
+        else {
+            filteredMediaOffsetNs = previousMediaOffsetNs +
+                    ((measuredMediaOffsetNs - previousMediaOffsetNs) >>
+                            MEDIA_OFFSET_FILTER_SHIFT);
+        }
+        videoMediaOffsetNs.set(filteredMediaOffsetNs);
+        videoMediaTimeMs.set(mediaPresentationTimeMs);
+        videoMediaUpdatedAtNs.set(updateTimeNs);
+    }
+
+    public static long getAudioReleaseDeadlineNs(long mediaPresentationTimeMs,
+                                                 long receivedAtNs) {
+        long desiredPresentationNs = getDesiredAudioPresentationNs(
+                mediaPresentationTimeMs, receivedAtNs);
+        long releaseDeadlineNs = desiredPresentationNs - audioSinkLeadNs.get() +
+                audioDeadlineCorrectionNs.get() - schedulerCompensationNs.get();
+        return Math.max(receivedAtNs,
+                Math.min(releaseDeadlineNs,
+                        receivedAtNs + MAXIMUM_AUDIO_WRITE_HOLDBACK_NS));
+    }
+
+    public static long getDesiredAudioPresentationNs(long mediaPresentationTimeMs,
+                                                     long fallbackReceivedAtNs) {
+        long nowNs = System.nanoTime();
+        if (isMediaTimelineCompatible(mediaPresentationTimeMs, nowNs)) {
+            return videoMediaOffsetNs.get() +
+                    mediaPresentationTimeMs * NANOS_PER_MILLISECOND;
+        }
+        return fallbackReceivedAtNs + getVideoHoldbackNs(nowNs);
+    }
+
+    public static void updateAudioPresentation(long mediaPresentationTimeMs,
+                                               long receivedAtNs,
+                                               long predictedPresentationNs,
+                                               long measuredSinkLeadNs,
+                                               long measuredQueueLeadNs,
+                                               long updateTimeNs) {
+        if (predictedPresentationNs <= receivedAtNs ||
+                measuredSinkLeadNs < 0 ||
+                measuredSinkLeadNs > MAXIMUM_AUDIO_SINK_LEAD_NS ||
+                measuredQueueLeadNs < 0 ||
+                measuredQueueLeadNs > MAXIMUM_AUDIO_QUEUE_LEAD_NS) {
+            return;
+        }
+
+        smoothAtomic(audioSinkLeadNs, measuredSinkLeadNs, SINK_FILTER_SHIFT);
+        audioQueueLeadNs.set(measuredQueueLeadNs);
+
+        long desiredPresentationNs = getDesiredAudioPresentationNs(
+                mediaPresentationTimeMs, receivedAtNs);
+        long phaseErrorNs = desiredPresentationNs - predictedPresentationNs;
+        phaseErrorNs = Math.max(-MAXIMUM_AUDIO_PHASE_ERROR_NS,
+                Math.min(phaseErrorNs, MAXIMUM_AUDIO_PHASE_ERROR_NS));
+        smoothAtomic(audioPhaseErrorNs, phaseErrorNs, AUDIO_PHASE_FILTER_SHIFT);
+        long samples = audioPhaseSamples.incrementAndGet();
+        if (samples < AUDIO_PHASE_WARMUP_SAMPLES ||
+                !isMediaTimelineCompatible(mediaPresentationTimeMs, updateTimeNs)) {
+            return;
+        }
+
+        long correctionStepNs = audioPhaseErrorNs.get() >> AUDIO_CORRECTION_SHIFT;
+        correctionStepNs = Math.max(-NANOS_PER_MILLISECOND,
+                Math.min(correctionStepNs, NANOS_PER_MILLISECOND));
+        addClampedAtomic(audioDeadlineCorrectionNs, correctionStepNs,
+                -MAXIMUM_AUDIO_DEADLINE_CORRECTION_NS,
+                MAXIMUM_AUDIO_DEADLINE_CORRECTION_NS);
+    }
+
+    public static void reportAudioWriterWake(long releaseDeadlineNs, long wokeAtNs) {
+        long latenessNs = Math.max(0, wokeAtNs - releaseDeadlineNs);
+        latenessNs = Math.min(latenessNs, MAXIMUM_SCHEDULER_COMPENSATION_NS);
+        smoothAtomic(schedulerCompensationNs, latenessNs, SCHEDULER_FILTER_SHIFT);
+    }
+
+    public static float getAudioPlaybackSpeed(boolean drainAudioQueue) {
+        long phaseErrorNs = audioPhaseSamples.get() >= AUDIO_PHASE_WARMUP_SAMPLES ?
+                audioPhaseErrorNs() : 0;
+        long desiredSpeed = PLAYBACK_SPEED_SCALE -
+                phaseErrorNs / PLAYBACK_SPEED_ERROR_DIVISOR;
+        desiredSpeed = Math.max(MINIMUM_PLAYBACK_SPEED,
+                Math.min(desiredSpeed, MAXIMUM_PLAYBACK_SPEED));
+        if (drainAudioQueue) {
+            desiredSpeed = MAXIMUM_PLAYBACK_SPEED;
+        }
+        long speed = slewAtomic(appliedPlaybackSpeed, desiredSpeed,
+                MAXIMUM_PLAYBACK_SPEED_STEP);
+        return (float) speed / PLAYBACK_SPEED_SCALE;
+    }
+
+    public static float getCurrentAudioPlaybackSpeed() {
+        return (float) appliedPlaybackSpeed.get() / PLAYBACK_SPEED_SCALE;
+    }
+
+    public static long getVideoHoldbackNs(long nowNs) {
+        long updatedAtNs = videoUpdatedAtNs.get();
+        if (updatedAtNs == 0 || nowNs - updatedAtNs > MEDIA_CLOCK_STALE_NS) {
+            return NOMINAL_VIDEO_HOLDBACK_NS;
+        }
+        return videoHoldbackNs.get();
+    }
+
+    public static long getSchedulerCompensationNs() {
+        return schedulerCompensationNs.get();
+    }
+
+    public static long getAudioSinkLeadNs() {
+        return audioSinkLeadNs.get();
+    }
+
+    public static long getAudioQueueLeadNs() {
+        return audioQueueLeadNs.get();
+    }
+
+    public static long getAudioPhaseErrorNs() {
+        return audioPhaseErrorNs();
+    }
+
+    public static long getAudioDeadlineCorrectionNs() {
+        return audioDeadlineCorrectionNs.get();
+    }
+
+    public static long getLatestVideoMediaTimeMs() {
+        return videoMediaTimeMs.get();
+    }
+
+    public static long getVideoDepthChangeNs(long nowNs) {
+        long updatedAtNs = videoUpdatedAtNs.get();
+        long baselineHoldbackNs = videoBaselineHoldbackNs.get();
+        if (baselineHoldbackNs < 0 ||
+                videoBaselineSamples.get() < VIDEO_BASELINE_SAMPLES ||
+                nowNs - updatedAtNs > MEDIA_CLOCK_STALE_NS) {
+            return 0;
+        }
+        return videoHoldbackNs.get() - baselineHoldbackNs;
+    }
+
+    public static long getBaselineHoldbackNs() {
+        return NOMINAL_VIDEO_HOLDBACK_NS;
+    }
+
+    public static boolean isMediaTimelineActive(long mediaPresentationTimeMs,
+                                                long nowNs) {
+        return isMediaTimelineCompatible(mediaPresentationTimeMs, nowNs);
+    }
+
+    private static boolean isMediaTimelineCompatible(long mediaPresentationTimeMs,
+                                                     long nowNs) {
+        long latestVideoMediaTimeMs = videoMediaTimeMs.get();
+        long mediaUpdatedAtNs = videoMediaUpdatedAtNs.get();
+        return mediaPresentationTimeMs >= 0 &&
+                latestVideoMediaTimeMs >= 0 &&
+                mediaUpdatedAtNs > 0 &&
+                nowNs - mediaUpdatedAtNs <= MEDIA_CLOCK_STALE_NS &&
+                Math.abs(mediaPresentationTimeMs - latestVideoMediaTimeMs) <=
+                        MEDIA_TIMELINE_COMPATIBILITY_MS;
+    }
+
+    private static long audioPhaseErrorNs() {
+        return audioPhaseErrorNs.get();
+    }
+
+    private static long slewAtomic(AtomicLong value, long target, long maximumStep) {
+        long previous;
+        long next;
+        do {
+            previous = value.get();
+            long difference = target - previous;
+            long step = Math.max(-maximumStep, Math.min(difference, maximumStep));
+            next = previous + step;
+        } while (!value.compareAndSet(previous, next));
+        return next;
+    }
+
+    private static void smoothAtomic(AtomicLong value, long sample, int filterShift) {
+        long previous;
+        long filtered;
+        do {
+            previous = value.get();
+            filtered = previous + ((sample - previous) >> filterShift);
+        } while (!value.compareAndSet(previous, filtered));
+    }
+
+    private static void addClampedAtomic(AtomicLong value, long increment,
+                                         long minimum, long maximum) {
+        long previous;
+        long next;
+        do {
+            previous = value.get();
+            next = Math.max(minimum, Math.min(previous + increment, maximum));
+        } while (!value.compareAndSet(previous, next));
+    }
+}
