+    private String describeJmgoStarvationStage(long nowNs) {
+        if (stageAgeNs(nowNs, lastDecodeUnitNs) > VIDEO_STAGE_FRESH_NS) {
+            return "decode-input";
+        }
+        if (stageAgeNs(nowNs, lastDecoderOutputNs) > VIDEO_STAGE_FRESH_NS) {
+            return "codec-output";
+        }
+        if (stageAgeNs(nowNs, lastImageReaderNs) > VIDEO_STAGE_FRESH_NS) {
+            return "image-reader";
+        }
+        Thread preparationThread = imagePreparationThread;
+        if (preparationThread == null || !preparationThread.isAlive()) {
+            return "image-preparation-thread";
+        }
+        if (stageAgeNs(nowNs, lastPreparedImageNs) > VIDEO_STAGE_FRESH_NS) {
+            return "image-preparation";
+        }
+        return "prepared-queue";
+    }
