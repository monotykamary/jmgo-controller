#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
work_dir=${1:-/tmp/artemis-jmgo-v20.2.6}

if [[ -e "$work_dir" ]]; then
  printf 'Refusing to overwrite existing path: %s\n' "$work_dir" >&2
  exit 1
fi

if [[ -z "${JAVA_HOME:-}" && -d /opt/homebrew/opt/openjdk@21 ]]; then
  export JAVA_HOME=/opt/homebrew/opt/openjdk@21
fi
if [[ -z "${ANDROID_HOME:-}" ]]; then
  if [[ -d /opt/homebrew/share/android-commandlinetools ]]; then
    export ANDROID_HOME=/opt/homebrew/share/android-commandlinetools
  elif [[ -d "$HOME/Library/Android/sdk" ]]; then
    export ANDROID_HOME="$HOME/Library/Android/sdk"
  fi
fi

: "${JAVA_HOME:?Set JAVA_HOME to JDK 21}"
: "${ANDROID_HOME:?Set ANDROID_HOME to an SDK containing platform 36 and NDK 27.0.12077973}"

git clone --quiet --depth 1 --branch v20.2.6 --recurse-submodules --shallow-submodules \
  https://github.com/ClassicOldSong/moonlight-android.git "$work_dir"

expected_artemis=4de0227fb6ae5c9ad9f7cc486aed7c3571f5f62f
expected_common_c=ad329b240f18826f320ce6a99226b36354b86b59
actual_artemis=$(git -C "$work_dir" rev-parse HEAD)
common_c="$work_dir/app/src/main/jni/moonlight-core/moonlight-common-c"
actual_common_c=$(git -C "$common_c" rev-parse HEAD)
if [[ "$actual_artemis" != "$expected_artemis" || "$actual_common_c" != "$expected_common_c" ]]; then
  printf 'Unexpected upstream revision: Artemis %s, moonlight-common-c %s\n' \
    "$actual_artemis" "$actual_common_c" >&2
  exit 1
fi

git -C "$work_dir" -c core.whitespace=cr-at-eol apply --check "$script_dir/artemis-v20.2.6.patch"
git -C "$work_dir" -c core.whitespace=cr-at-eol apply "$script_dir/artemis-v20.2.6.patch"

git -C "$common_c" -c core.whitespace=cr-at-eol apply --check "$script_dir/moonlight-common-c.patch"
git -C "$common_c" -c core.whitespace=cr-at-eol apply "$script_dir/moonlight-common-c.patch"

(
  cd "$work_dir"
  ./gradlew app:assembleNonRoot_gameDebug
)

apk="$work_dir/app/build/outputs/apk/nonRoot_game/debug/app-nonRoot_game-debug.apk"
shasum -a 256 "$apk"
printf '%s\n' "$apk"
