diff --git a/src/VideoStream.c b/src/VideoStream.c
index a2def84..0b3cb8a 100644
--- a/src/VideoStream.c
+++ b/src/VideoStream.c
@@ -253,6 +253,13 @@ void notifyKeyFrameReceived(void) {
 
 // Decoder thread proc
 static void VideoDecoderThreadProc(void* context) {
+    const uint64_t presentationLeadMs = 0;
+    uint64_t baseLocalTimeMs = 0;
+    uint32_t basePresentationTimeMs = 0;
+    uint32_t lastPresentationTimeMs = 0;
+    bool presentationClockStarted = false;
+    unsigned int lateFrameCount = 0;
+
     while (!PltIsThreadInterrupted(&decoderThread)) {
         VIDEO_FRAME_HANDLE frameHandle;
         PDECODE_UNIT decodeUnit;
@@ -261,6 +268,48 @@ static void VideoDecoderThreadProc(void* context) {
             return;
         }
 
+        uint64_t nowMs = PltGetMillis();
+        uint32_t presentationTimeMs = decodeUnit->presentationTimeMs;
+        uint32_t presentationDeltaMs = presentationTimeMs - lastPresentationTimeMs;
+        bool discontinuity = presentationClockStarted &&
+            (presentationTimeMs <= lastPresentationTimeMs || presentationDeltaMs > 100);
+
+        if (discontinuity) {
+            Limelog("JMGO host presentation discontinuity: %u ms\n", presentationDeltaMs);
+        }
+        if (!presentationClockStarted || discontinuity) {
+            baseLocalTimeMs = nowMs + presentationLeadMs;
+            basePresentationTimeMs = presentationTimeMs;
+            presentationClockStarted = true;
+            Limelog("JMGO input pacing started with %llu ms lead\n",
+                    (unsigned long long)presentationLeadMs);
+        }
+
+        uint64_t targetTimeMs = baseLocalTimeMs +
+            (uint32_t)(presentationTimeMs - basePresentationTimeMs);
+        if (targetTimeMs > nowMs) {
+            uint64_t sleepMs = targetTimeMs - nowMs;
+            PltSleepMsInterruptible(&decoderThread,
+                                    sleepMs > INT_MAX ? INT_MAX : (int)sleepMs);
+            if (PltIsThreadInterrupted(&decoderThread)) {
+                LiCompleteVideoFrame(frameHandle, DR_OK);
+                return;
+            }
+        }
+        else if (nowMs - targetTimeMs >= 50) {
+            lateFrameCount++;
+            Limelog("JMGO input pacing late %u: %llu ms\n",
+                    lateFrameCount,
+                    (unsigned long long)(nowMs - targetTimeMs));
+        }
+
+        lastPresentationTimeMs = presentationTimeMs;
+
+        // MediaCodec propagates input PTS into the Surface buffer even when the Java
+        // renderer requests immediate display. Replace bursty network enqueue time with
+        // the smoothed host-presentation clock so OMX never batches equal timestamps.
+        decodeUnit->enqueueTimeMs = targetTimeMs;
+
         LiCompleteVideoFrame(frameHandle, VideoCallbacks.submitDecodeUnit(decodeUnit));
     }
 }
