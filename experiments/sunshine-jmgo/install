#!/usr/bin/env bash
set -euo pipefail

source_app=${1:-/tmp/sunshine-jmgo-v2026.726.710/cmake-build-jmgo/Sunshine.app}
destination=${2:-/Applications/Sunshine JMGO.app}

[[ -x "$source_app/Contents/MacOS/Sunshine" ]] || {
  printf 'Built Sunshine app not found: %s\n' "$source_app" >&2
  exit 1
}
[[ -f "$source_app/Contents/Resources/assets/web/index.html" ]] || {
  printf 'Built Sunshine app is missing its Web UI: %s\n' "$source_app" >&2
  exit 1
}
if [[ -e "$destination" ]]; then
  printf 'Refusing to replace %s; replacing an authorized build requires Screen Recording reauthorization.\n' "$destination" >&2
  exit 1
fi

/usr/bin/ditto "$source_app" "$destination"
/usr/bin/plutil -replace CFBundleIdentifier -string dev.lizardbyte.app.Sunshine.jmgo "$destination/Contents/Info.plist"
/usr/bin/plutil -replace CFBundleDisplayName -string 'Sunshine JMGO' "$destination/Contents/Info.plist"
/usr/bin/plutil -replace CFBundleName -string 'Sunshine JMGO' "$destination/Contents/Info.plist"
/usr/bin/xattr -cr "$destination"
/usr/bin/codesign --force --deep --sign - "$destination"
/usr/bin/codesign --verify --deep --strict "$destination"

firewall=/usr/libexec/ApplicationFirewall/socketfilterfw
if ! "$firewall" --add "$destination" || ! "$firewall" --unblockapp "$destination"; then
  printf 'Warning: add the app to the macOS firewall manually or rerun socketfilterfw with sudo.\n' >&2
fi

printf 'Installed %s\n' "$destination"
printf 'Open it once, then enable Sunshine JMGO in Privacy & Security > Screen & System Audio Recording.\n'
printf 'The jmgo CLI will prefer this app automatically when it is installed at the default path.\n'
