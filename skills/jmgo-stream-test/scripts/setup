#!/usr/bin/env bash
set -euo pipefail
script_dir="$(cd "$(dirname "$0")" && pwd)"
skill_dir="$(dirname "$script_dir")"
cli="$skill_dir/scripts/jmgo-stream-test"
target_dir="$HOME/.local/bin"
if [ ! -f "$cli" ]; then echo "Error: $cli not found" >&2; exit 1; fi
if ! echo ":$PATH:" | grep -q ":$target_dir:"; then
  mkdir -p "$target_dir"
  profile=""
  for f in "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.profile"; do if [ -f "$f" ]; then profile="$f"; break; fi; done
  if [ -n "$profile" ] && ! grep -q '\.local/bin' "$profile"; then printf '\nexport PATH="$HOME/.local/bin:$PATH"\n' >> "$profile"; echo "Added $target_dir to PATH in $profile"; fi
  export PATH="$target_dir:$PATH"
fi
mkdir -p "$target_dir"
chmod +x "$cli" "$script_dir/test"
ln -sf "$cli" "$target_dir/jmgo-stream-test"
echo "Linked: $target_dir/jmgo-stream-test"
for dep in node adb ffmpeg; do command -v "$dep" >/dev/null 2>&1 || echo "Warning: $dep not found" >&2; done
